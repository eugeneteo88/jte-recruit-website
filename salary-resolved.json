  "floor": {
    "amount": 2500,
    "appliesTo": "Full-time basic monthly salary, Singapore, 5-day week",
    "source": "JTE, November 2026",
    "short": "Below about S$2,500 basic a month, a role gets much harder to fill locally.",
    "long": "This is not a rule, it is what we see. You can hire below it, but expect to wait a lot longer and to lose people to the employer up the road. Everyone is comparing. For hands-on roles on a 5-day week, S$2,500 is roughly where the market starts now.",
    "exemptNote": "The S$2,500 guide is about basic pay where the basic is the whole package. Plenty of hands-on roles run a lower basic with overtime and incentives on top, and there you judge the gross instead. Where we know both, we show both."
  },
  "tracks": {
    "operative": {
      "label": "Hands-on roles",
      "bands": [
        "Basic",
        "Gross"
      ],
      "sub": {
        "Basic": "contract basic, monthly",
        "Gross": "take-home with OT and allowances"
      },
      "note": "Hands-on roles do not really have a junior-to-senior ladder, but they do have two numbers that matter. The basic is what you commit to. The gross is what the person takes home once overtime, incentives and allowances land, and it is the number they compare against the employer up the road. Supervisor and team leader roles sit separately, because that is more responsibility rather than the same job for longer."
    },
    "professional": {
      "label": "Professional & executive roles",
      "bands": [
        "0-3 yrs",
        "3-8 yrs",
