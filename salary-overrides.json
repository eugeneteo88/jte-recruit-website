{
  "_comment": [
    "JTE's own layer on top of the weekly market pull. salary-data.json is",
    "overwritten every Saturday by the refresh, so anything we know that the",
    "raw numbers do not must live HERE or it gets wiped.",
    "scripts/resolve-salary.mjs merges this over the raw pull."
  ],
  "floor": {
    "amount": 2500,
    "appliesTo": "Full-time basic monthly salary, Singapore, 5-day week",
    "source": "JTE, November 2026",
    "short": "Below about S$2,500 basic a month, a role gets much harder to fill locally.",
    "long": "This is not a rule, it is what we see. You can hire below it, but expect to wait a lot longer and to lose people to the employer up the road. Everyone is comparing. For hands-on roles on a 5-day week, S$2,500 is roughly where the market starts now."
  },
  "tracks": {
    "operative": {
      "label": "Hands-on roles",
      "bands": [
        "Typical",
        "With experience"
      ],
      "sub": {
        "Typical": "the going rate",
        "With experience": "with real time on the job"
      },
      "note": "Hands-on roles do not have a junior-to-senior ladder. There is the going rate, and what experience adds. Supervisor and manager roles sit separately, because they are a different job rather than the same job with more years."
    },
    "professional": {
      "label": "Professional & executive roles",
      "bands": [
        "0-3 yrs",
        "3-8 yrs",
        "8+ yrs"
      ],
      "sub": {
        "0-3 yrs": "early career",
        "3-8 yrs": "experienced",
        "8+ yrs": "senior, lead, manager"
      },
      "note": "Banded by experience, because that is how employers brief us."
    }
  },
